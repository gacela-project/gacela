# Mutation testing mangles sys_get_temp_dir() into a relative path, so a mutated
# run writes its temp fixtures into the repo root instead of /tmp. The resulting
# paths are invalid on Windows and break `git checkout` there if committed.
gacela-uncreatable-*/
gacela-filecache-test-*/
gacela-scoped-bench-*/
gacela-doctor-strict-*/
