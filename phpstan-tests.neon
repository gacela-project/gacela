includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 0
    paths:
        - %currentWorkingDirectory%/tests/
        - %currentWorkingDirectory%/symfony-bridge/tests/
    excludePaths:
        - %currentWorkingDirectory%/tests/Unit/PHPStan/Rules/Fixture/*
        # Fixtures that are deliberately wrong: an attribute pointing at a class
        # that does not exist, and a call to a method that does not exist. Both
        # are the input the reflection extension is asserted against.
        - %currentWorkingDirectory%/tests/Unit/PHPStan/Reflection/Fixture/*
        # assertType() data file: its assertions only hold with phpstan-gacela.neon
        # loaded, which this config does not include. It is checked by
        # GetProvidedDependencyTypeInferenceTest, which does load the extension.
        - %currentWorkingDirectory%/tests/Unit/PHPStan/Reflection/TypeFixture/*
        - %currentWorkingDirectory%/tests/Integration/PHPStan/Fixture/*
    ignoreErrors:
        - '#Class GacelaTest\\Unit\\Framework\\Container\\NonExisting not found.#'
        - '#has invalid type Totally\\Missing\\Type#'
        - '#Access to constant on internal class Gacela\\Framework\\Container\\Locator.#'
        # Psalm exposes no public way to observe that a plugin registered a hook;
        # the registration lands in its internal event dispatcher. Driving the
        # entry point in-process is what puts it under the mutation gate at all,
        # so the coupling is deliberate and confined to this one test.
        -
            identifier: new.internalClass
            path: %currentWorkingDirectory%/tests/Unit/Psalm/PluginTest.php
        -
            identifier: parameter.internalClass
            path: %currentWorkingDirectory%/tests/Unit/Psalm/PluginTest.php
        # ProvidesScanner's memo is a private static with no public accessor, and
        # reading it is the only way to observe that a repeated scan is skipped.
        -
            identifier: classConstant.internalClass
            path: %currentWorkingDirectory%/tests/Unit/Framework/Attribute/ProvidesScannerTest.php
        # Same shape: AnonymousGlobal's instance cache is a private static, and an
        # un-normalized key can only be planted in it directly.
        -
            identifier: classConstant.internalClass
            path: %currentWorkingDirectory%/tests/Unit/Framework/ClassResolver/GlobalInstance/AnonymousGlobalTest.php
